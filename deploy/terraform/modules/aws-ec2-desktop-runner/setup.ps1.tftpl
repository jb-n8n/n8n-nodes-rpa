# RPA desktop test bed, first boot (Terraform module aws-ec2-desktop-runner). The user data (user-data.ps1.tftpl)
# unpacks and runs this once, as LocalSystem under EC2Launch v2. It does what is specific to the test bed and leaves the
# product to the product's installer: with package_url set it downloads the RPA Windows package, checks its SHA-256,
# runs its Install-Rpa.ps1 (the user rpa-runner, automatic sign-in, the data directory, the tokens, the firewall rules
# and the scheduled tasks are the installer's work), applies runner_policy with the package's RpaPolicy.exe, and
# restarts so that rpa-runner signs in on the console. Without package_url it installs nothing of the product.
#
# Every text value from Terraform arrives base64-encoded, so no input can break out of a string. The passwords are made
# here and written to Secrets Manager before they are used; the two tokens are made by the installer and copied to
# Secrets Manager after it. None is written to output or a log, and a password is text only on its way to Secrets
# Manager: Windows gets it as a SecureString that is filled character by character, not by a command that takes text.
# What belongs to the test bed (this log, the done marker, install-package.ps1, the policy change file, the unpacked
# package while it installs) is in C:\Program Files\RPA Test Bed, which only SYSTEM and Administrators can read or
# change. Progress: setup.log there.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
function Dec([string]$b64) { if ($b64) { [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b64)) } else { '' } }

$Region       = Dec '${region}'
$AdminPwArn   = Dec '${admin_password_secret_arn}'
%{ if install_package ~}
$UserPwArn    = Dec '${runner_user_password_secret_arn}'
$TokenArn     = Dec '${runner_token_secret_arn}'
$BrowserArn   = Dec '${browser_token_secret_arn}'
$PackageUrl   = Dec '${package_url}'
$PackageSha   = Dec '${package_sha256}'
$PolicyChange = Dec '${policy_change}'
$RunnerPort   = [int]'${runner_port}'
$BrowserPort  = [int]'${browser_port}'
$User         = 'rpa-runner'
%{ endif ~}

$Root           = Join-Path $env:ProgramFiles 'RPA Test Bed'
$SetupLog       = Join-Path $Root 'setup.log'
$Done           = Join-Path $Root 'setup.done'
$InstallPackage = Join-Path $Root 'install-package.ps1'

# Created with its owner (Administrators) and access rules (SYSTEM and Administrators in full, nobody else) in one call.
if (-not (Test-Path -LiteralPath $Root)) {
  $rules = New-Object Security.AccessControl.DirectorySecurity
  $rules.SetSecurityDescriptorSddlForm('O:BAD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)')
  [void][IO.Directory]::CreateDirectory($Root, $rules)
}
function Log([string]$m) { Add-Content -LiteralPath $SetupLog -Value ('{0} {1}' -f (Get-Date -Format o), $m) }
if (Test-Path -LiteralPath $Done) { Log 'setup already done'; exit 0 }
trap { Log ('setup FAILED at line {0}: {1}' -f $_.InvocationInfo.ScriptLineNumber, $_.Exception.Message); exit 1 }
Log 'setup started'

# 64 symbols, so a random byte modulo 64 is uniform; retried until it has an upper, a lower and a digit and no part of
# an account or full name (Windows' complexity rule refuses a password containing rpa, runner or admin). No command and
# no pipeline touches the characters.
function New-Secret([int]$Length) {
  $alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_'
  $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
  try {
    $bytes = New-Object byte[] $Length
    $chars = New-Object char[] $Length
    do {
      $rng.GetBytes($bytes)
      for ($i = 0; $i -lt $Length; $i++) { $chars[$i] = $alphabet[$bytes[$i] % 64] }
      $s = -join $chars
    } until ($s -cmatch '[A-Z]' -and $s -cmatch '[a-z]' -and $s -cmatch '[0-9]' -and $s -notmatch 'rpa|runner|admin')
  } finally { $rng.Dispose() }
  $s
}

# The instance profile can take a minute to reach a new instance, so retry for up to ten minutes.
function Save-Secret([string]$Arn, [string]$Value) {
  for ($i = 1; $i -le 60; $i++) {
    try { Write-SECSecretValue -SecretId $Arn -SecretString $Value -Region $Region | Out-Null; return }
    catch {
      if ($i -eq 60) { throw }
      Log ('Secrets Manager not ready (attempt {0}): {1}' -f $i, $_.Exception.Message)
      Start-Sleep -Seconds 10
    }
  }
}

# A new random password: written to Secrets Manager first, then handed back as a SecureString.
function New-StoredPassword([string]$Arn) {
  $plain = New-Secret 32
  Save-Secret $Arn $plain
  $secure = New-Object Security.SecureString
  foreach ($char in $plain.ToCharArray()) { $secure.AppendChar($char) }
  $secure.MakeReadOnly()
  $secure
}

# 1. Windows Firewall on for every profile, and no instance metadata for any member of the Windows group Users (BU):
#    an outbound rule blocks 169.254.169.254 for them. It needs no user of the product, so it is there whether or not
#    a package is installed now, by hand later, or its install fails half way. It comes before every secret write
#    below, which all run as SYSTEM: SYSTEM is not a member of Users, and a write that fails here would show that the
#    rule reaches further than meant. install-package.ps1 adds a second rule for the bot user by its SID.
Set-NetFirewallProfile -All -Enabled True
if (-not (Get-NetFirewallRule -Name 'RPA-TestBed-No-IMDS' -ErrorAction SilentlyContinue)) {
  New-NetFirewallRule -Name 'RPA-TestBed-No-IMDS' -DisplayName 'Block instance metadata for members of Users' -Direction Outbound -Protocol TCP -RemoteAddress '169.254.169.254' -LocalUser 'D:(A;;CC;;;BU)' -Action Block | Out-Null
}
Log 'Windows Firewall on for every profile; instance metadata blocked for members of Users'

# 2. The Windows PowerShell event log, for SYSTEM and Administrators only. Windows PowerShell can record the text of
#    scripts it runs there, and this script's text holds the package URL.
& (Join-Path ([Environment]::SystemDirectory) 'wevtutil.exe') sl 'Microsoft-Windows-PowerShell/Operational' '/ca:O:BAG:SYD:(A;;0xf0007;;;SY)(A;;0x7;;;BA)' | Out-Null
if ($LASTEXITCODE -ne 0) { throw ('wevtutil.exe could not set the access of the Windows PowerShell event log (exit code {0})' -f $LASTEXITCODE) }
Log 'Windows PowerShell event log readable by SYSTEM and Administrators only'

# 3. The built-in Administrator (RDP): a new random password, kept only in Secrets Manager.
$secure = New-StoredPassword $AdminPwArn
Get-LocalUser | Where-Object { $_.SID.Value -like 'S-1-5-21-*-500' } | Set-LocalUser -Password $secure
Log 'Administrator password set (in Secrets Manager)'

# 4. install-package.ps1, for the first install below and for desktop-testbed.sh install (an upgrade over SSM).
Set-Content -LiteralPath $InstallPackage -Encoding UTF8 -Value @'
${install_package_ps1}
'@

%{ if install_package ~}
# 5. The product: rpa-runner's password (in Secrets Manager before the installer gets it), then the package's own
#    installer, which creates rpa-runner as a standard user with that password and stores it for automatic sign-in.
#    Its Windows Firewall rules let the two ports in from any address: the allowed CIDRs are not in this script, so a
#    change of them does not replace the VM, and the security group is what limits who reaches the ports.
#    install-package.ps1 adds the metadata block for rpa-runner straight after the installer returns. A refused or
#    failed install fails the setup: the lines of install-package.ps1 and of the installer are in this log.
$secure = New-StoredPassword $UserPwArn
Log 'rpa-runner password made (in Secrets Manager)'
& $InstallPackage -Url $PackageUrl -Sha256 $PackageSha -User $User -UserPassword $secure -RunnerPort $RunnerPort -BrowserPort $BrowserPort | ForEach-Object { Log $_ }
$secure = $null

# 6. The two tokens the installer made, copied to Secrets Manager. They go nowhere else.
$DataDir = Join-Path $env:ProgramData 'RPA Runner'
foreach ($pair in @(@('token', $TokenArn), @('browser-token', $BrowserArn))) {
  $arn = $pair[1]
  $value = [IO.File]::ReadAllText((Join-Path $DataDir $pair[0])).Trim()
  if (-not $value) { throw ('{0} is empty' -f $pair[0]) }
  Save-Secret $arn $value
  $value = $null
}
Log 'runner and browser tokens copied to Secrets Manager'

# 7. runner_policy, on top of the installer's starter policy (no app allowed), through the package's policy tool. The
#    change file is in the test bed's folder, which only administrators can change. The tool honours --yes only when
#    every other process attached to its console is elevated, and otherwise asks "Apply these changes? [y/N]": nobody
#    is there at a first boot, so the answer is also on its standard input. Its lines go to this log; a refusal fails
#    the setup and leaves the starter policy.
function Invoke-PolicyTool([string]$tool, [string]$change) {
  # What the tool writes to its error stream must not end the setup by itself; its exit code decides.
  $ErrorActionPreference = 'Continue'
  'y' | & $tool apply $change --yes 2>&1 | ForEach-Object { Log "RpaPolicy: $_" }
}
$change = Join-Path $Root 'policy-change.json'
[IO.File]::WriteAllText($change, $PolicyChange, (New-Object Text.UTF8Encoding $false))
$global:LASTEXITCODE = -1
Invoke-PolicyTool (Join-Path $env:ProgramFiles 'RPA Runner\runner\RpaPolicy.exe') $change
if ($LASTEXITCODE -ne 0) { throw ('RpaPolicy.exe did not apply the policy change (exit code {0}); the policy stays as it was' -f $LASTEXITCODE) }
Log 'policy change applied'

Set-Content -LiteralPath $Done -Value (Get-Date -Format o)
Log 'setup done; restarting so rpa-runner signs in'
& (Join-Path ([Environment]::SystemDirectory) 'shutdown.exe') /r /t 15 /d p:4:1 /c 'RPA test bed setup done' | Out-Null
if ($LASTEXITCODE -ne 0) { throw ('shutdown.exe failed with exit code {0}' -f $LASTEXITCODE) }
%{ else ~}
Set-Content -LiteralPath $Done -Value (Get-Date -Format o)
Log 'setup done; no package_url, so nothing of the product is installed'
%{ endif ~}
exit 0
