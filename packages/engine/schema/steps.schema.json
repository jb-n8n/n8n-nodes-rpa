{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "n8n-nodes-rpa step document",
  "description": "Steps for the RPA node's Run Steps operation: a document { name?, version?, startUrl?, interrupts?, steps } or a bare array of steps. Hand-written to mirror the engine's parseScript; parseScript also checks that regular expressions compile, that detect.require names one of the checks, and that without a startUrl the first step is an absolute goto (or the node's Start URL is set).",
  "oneOf": [
    { "$ref": "#/definitions/document" },
    { "$ref": "#/definitions/steps" }
  ],
  "definitions": {
    "document": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "surface": { "const": "browser", "description": "What the steps drive. Absent or \"browser\" here; desktop step sets (\"desktop\") are a different document this schema does not cover." },
        "name": { "type": "string", "minLength": 1, "description": "The step list's name. Signed steps carry it, and the Data Tables are keyed by it." },
        "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "The version of these steps. Sign Steps signs it; Run Steps checks it as Expected Version." },
        "startUrl": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://", "description": "An absolute http(s) URL where the run starts. Without it, the first step's absolute goto, else the node's Start URL." },
        "interrupts": {
          "type": "array",
          "description": "Pop-ups dismissed whenever they appear: when target shows, click click.",
          "items": { "$ref": "#/definitions/interrupt" }
        },
        "steps": { "$ref": "#/definitions/steps" }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/definitions/step" }
    },
    "interrupt": {
      "type": "object",
      "required": ["target", "click"],
      "properties": {
        "target": { "$ref": "#/definitions/interruptLocator" },
        "click": { "$ref": "#/definitions/interruptLocator" }
      },
      "additionalProperties": false
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "regex": { "type": "string", "minLength": 1, "description": "A JavaScript regular expression (it must compile)." },
    "varTemplate": { "type": "string", "pattern": "\\{\\{\\s*var\\.[A-Za-z0-9_]+\\s*\\}\\}", "description": "A string that holds a {{var.name}} template (a run variable)." },
    "varName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "The name of a run variable (Options → Variables), without {{var. }}." },
    "conditionText": { "type": "string", "not": { "type": "string", "pattern": "\\{\\{" }, "description": "Literal text a run variable is compared with. Never rendered, so it may not hold {{." },
    "noVarLocator": {
      "type": "object",
      "description": "A locator no run variable may steer: no {{var.name}} in its name or text, within or fallbacks included (the other keys never take one).",
      "properties": {
        "name": { "not": { "$ref": "#/definitions/varTemplate" } },
        "text": { "not": { "$ref": "#/definitions/varTemplate" } },
        "within": { "$ref": "#/definitions/noVarLocator" },
        "fallbacks": { "type": "array", "items": { "$ref": "#/definitions/noVarLocator" } }
      }
    },
    "interruptLocator": {
      "description": "A pop-up handler's locator: never rendered, so no {{var.name}} anywhere.",
      "allOf": [
        { "$ref": "#/definitions/locatorInner" },
        { "$ref": "#/definitions/noVarLocator" }
      ]
    },
    "writeLocator": {
      "description": "A locator of a step that writes (submit, download): no {{var.name}} anywhere, so a run variable never steers a write.",
      "allOf": [
        { "$ref": "#/definitions/locator" },
        { "$ref": "#/definitions/noVarLocator" }
      ]
    },
    "writeWhen": {
      "type": "object",
      "description": "The when of a step that writes or signs in: an element condition only, never a run variable, and its locator holds no {{var.name}}.",
      "properties": { "visible": { "$ref": "#/definitions/noVarLocator" }, "hidden": { "$ref": "#/definitions/noVarLocator" } },
      "not": { "required": ["var"] }
    },
    "writeExpect": {
      "type": "object",
      "description": "The expect of a step that writes or signs in: its locator holds no {{var.name}}.",
      "properties": { "visible": { "$ref": "#/definitions/noVarLocator" } }
    },
    "locator": {
      "type": "object",
      "description": "Exactly one of role, label, text, testId or css, with optional name, exact, within, frame and fallbacks.",
      "properties": {
        "role": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" }, "description": "An ARIA role, such as button or link. Add name for its accessible name." },
        "label": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" }, "description": "The form label of a field." },
        "text": { "type": "string", "minLength": 1, "description": "Visible text. May hold {{var.name}}, rendered each run." },
        "testId": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" }, "description": "A data-testid value." },
        "css": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" }, "description": "A CSS selector." },
        "name": { "type": "string", "description": "The accessible name, for a role locator. May hold {{var.name}}, rendered each run (only beside role)." },
        "exact": { "type": "boolean", "description": "Whether the name or text must match exactly." },
        "frame": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" }, "description": "A CSS selector of the iframe to search inside." },
        "within": { "$ref": "#/definitions/locatorInner" },
        "fallbacks": {
          "type": "array",
          "maxItems": 5,
          "description": "Other locators tried in order when this one has no unique visible match. A fallback has no fallbacks of its own.",
          "items": { "$ref": "#/definitions/locatorInner" }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["role"] },
        { "required": ["label"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } },
        { "required": ["text"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } },
        { "required": ["testId"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } },
        { "required": ["css"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } }
      ]
    },
    "locatorInner": {
      "type": "object",
      "description": "A locator without fallbacks (inside within, a fallback or an interrupt).",
      "properties": {
        "role": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } },
        "label": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } },
        "text": { "type": "string", "minLength": 1 },
        "testId": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } },
        "css": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } },
        "name": { "type": "string" },
        "exact": { "type": "boolean" },
        "frame": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } },
        "within": { "$ref": "#/definitions/locatorInner" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["role"] },
        { "required": ["label"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } },
        { "required": ["text"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } },
        { "required": ["testId"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } },
        { "required": ["css"], "properties": { "name": { "not": { "$ref": "#/definitions/varTemplate" } } } }
      ]
    },
    "locatorNoFrame": {
      "description": "A sign-in locator: no frame, and no {{var.name}} anywhere (a run variable never steers a sign-in).",
      "allOf": [
        { "$ref": "#/definitions/locator" },
        { "$ref": "#/definitions/noVarLocator" },
        { "not": { "type": "object", "required": ["frame"] } }
      ]
    },
    "fileCheck": {
      "type": "object",
      "description": "What the downloaded file must be. Part of what Sign Steps signs.",
      "properties": {
        "name": { "$ref": "#/definitions/regex", "not": { "$ref": "#/definitions/varTemplate" }, "description": "A regular expression the sanitized file name must match. No {{var.name}}: a download writes, and a run variable never steers it." },
        "minBytes": { "type": "integer", "minimum": 1, "maximum": 209715200 },
        "columns": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 200, "not": { "$ref": "#/definitions/varTemplate" } } },
        "minRows": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      },
      "additionalProperties": false
    },
    "method": { "type": "string", "pattern": "^([Gg][Ee][Tt]|[Pp][Oo][Ss][Tt]|[Pp][Uu][Tt]|[Pp][Aa][Tt][Cc][Hh]|[Dd][Ee][Ll][Ee][Tt][Ee])$" },
    "fieldSpec": {
      "type": "object",
      "properties": {
        "locator": { "$ref": "#/definitions/locator" },
        "pattern": { "$ref": "#/definitions/regex" },
        "attribute": { "enum": ["text", "href", "src", "title", "alt", "aria-label"] }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["locator"] },
        { "required": ["pattern"] }
      ],
      "dependencies": { "attribute": ["locator"] }
    },
    "step": {
      "type": "object",
      "description": "One step: an intent and exactly one verb.",
      "required": ["intent"],
      "properties": {
        "intent": { "type": "string", "minLength": 1, "maxLength": 200, "description": "What the step does, in plain words (logs and errors)." },
        "optional": { "type": "boolean", "description": "Whether the run continues when this step finds nothing." },
        "when": {
          "type": "object",
          "description": "Run the step only when this holds, else skip it: an element is visible, an element is not visible (hidden), or a run variable's value equals (or does not equal) a literal text. Checked once, without waiting.",
          "oneOf": [
            { "type": "object", "required": ["visible"], "properties": { "visible": { "$ref": "#/definitions/locator" } }, "additionalProperties": false },
            { "type": "object", "required": ["hidden"], "properties": { "hidden": { "$ref": "#/definitions/locator" } }, "additionalProperties": false },
            { "type": "object", "required": ["var", "equals"], "properties": { "var": { "$ref": "#/definitions/varName" }, "equals": { "$ref": "#/definitions/conditionText" } }, "additionalProperties": false },
            { "type": "object", "required": ["var", "notEquals"], "properties": { "var": { "$ref": "#/definitions/varName" }, "notEquals": { "$ref": "#/definitions/conditionText" } }, "additionalProperties": false }
          ]
        },
        "expect": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "heading": { "type": "string", "minLength": 1 },
            "visible": { "$ref": "#/definitions/locator" }
          },
          "additionalProperties": false,
          "description": "What the page shows after the step."
        },
        "checkpoint": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 }
      },
      "oneOf": [
        { "$ref": "#/definitions/verb-goto" },
        { "$ref": "#/definitions/verb-signIn" },
        { "$ref": "#/definitions/verb-click" },
        { "$ref": "#/definitions/verb-fill" },
        { "$ref": "#/definitions/verb-select" },
        { "$ref": "#/definitions/verb-check" },
        { "$ref": "#/definitions/verb-clickAll" },
        { "$ref": "#/definitions/verb-waitFor" },
        { "$ref": "#/definitions/verb-paginate" },
        { "$ref": "#/definitions/verb-extract" },
        { "$ref": "#/definitions/verb-submit" },
        { "$ref": "#/definitions/verb-download" },
        { "$ref": "#/definitions/verb-popup" },
        { "$ref": "#/definitions/verb-detect" },
        { "$ref": "#/definitions/verb-screenshot" },
        { "$ref": "#/definitions/verb-pdf" },
        { "$ref": "#/definitions/verb-read" },
        { "$ref": "#/definitions/verb-extractTable" },
        { "$ref": "#/definitions/verb-press" },
        { "$ref": "#/definitions/verb-hover" }
      ]
    },
    "nestedStep": {
      "type": "object",
      "description": "A step inside paginate.each: no signIn and no paginate.",
      "required": ["intent"],
      "allOf": [{ "$ref": "#/definitions/step" }],
      "not": {
        "anyOf": [
          { "required": ["signIn"] },
          { "required": ["paginate"] }
        ]
      }
    },
    "verb-goto": {
      "type": "object",
      "required": ["goto"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "goto": { "type": "string", "minLength": 1, "description": "A URL or a path to open." },
        "waitUntil": { "enum": ["load", "domcontentloaded", "networkidle"] }
      },
      "additionalProperties": false
    },
    "verb-signIn": {
      "type": "object",
      "required": ["signIn"],
      "properties": {
        "intent": true, "optional": true, "when": { "$ref": "#/definitions/writeWhen" }, "expect": { "$ref": "#/definitions/writeExpect" }, "checkpoint": true, "timeoutMs": true,
        "signIn": {
          "type": "object",
          "description": "Types the RPA Site Login's username, password and code, and a new password when the site forces one (changePassword). Needs a Site Login.",
          "required": ["username", "password", "submit"],
          "properties": {
            "username": { "$ref": "#/definitions/locatorNoFrame" },
            "next": { "$ref": "#/definitions/locatorNoFrame", "description": "A two-page sign-in: the button that moves from the username page to the password page." },
            "password": { "$ref": "#/definitions/locatorNoFrame" },
            "submit": { "$ref": "#/definitions/locatorNoFrame" },
            "totp": {
              "type": "object",
              "required": ["field", "submit"],
              "properties": {
                "field": { "$ref": "#/definitions/locatorNoFrame" },
                "submit": { "$ref": "#/definitions/locatorNoFrame" },
                "source": { "enum": ["seed", "workflow"], "description": "Where the code comes from: \"seed\" (default) generates it from the Site Login's TOTP secret; \"workflow\" asks the node's One-Time Code Workflow once the code field shows." },
                "via": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/definitions/locatorNoFrame" }, "description": "Buttons on pages between the password and the code field (a factor choice, \"Send me the code\"), clicked in order, each only if it shows before the code field does. With via, the code field must show within the step timeout. With source \"workflow\", the retry after a rejected code clicks the last one again when the code page shows it." },
                "check": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/definitions/locatorNoFrame" }, "description": "Checkboxes ticked after the code is typed and before its submit (e.g. \"Trust this browser\")." }
              },
              "additionalProperties": false
            },
            "changePassword": {
              "type": "object",
              "description": "A site that forces a new password at sign-in: when detect shows after the sign-in (and its code), the step types the Site Login password into current, the variable's value into each new field, and clicks submit. The change page must be listed under Pages Where the Password May Be Typed, and the steps must be signed.",
              "required": ["detect", "current", "new", "submit", "value"],
              "properties": {
                "detect": { "$ref": "#/definitions/locatorNoFrame", "description": "An element only the change-password page shows." },
                "current": { "$ref": "#/definitions/locatorNoFrame", "description": "The current password field." },
                "new": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/definitions/locatorNoFrame" }, "description": "The new password field, and its confirmation when the page has one." },
                "submit": { "$ref": "#/definitions/locatorNoFrame" },
                "value": { "type": "string", "pattern": "^\\{\\{\\s*var\\.[A-Za-z0-9_]+\\s*\\}\\}$", "description": "Exactly one {{var.name}} template: the run variable that holds the new password. Masked in everything the run shows, like a secret fill." }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-click": {
      "type": "object",
      "required": ["click"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "click": { "$ref": "#/definitions/locator" },
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["Ctrl", "Shift", "Alt"] },
          "description": "Keys held during the click, such as [\"Ctrl\"] to add an item to a selection. A Ctrl+click or Shift+click on a link can open a tab the run does not follow."
        }
      },
      "additionalProperties": false
    },
    "verb-fill": {
      "type": "object",
      "required": ["fill"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "fill": {
          "type": "object",
          "required": ["field", "value"],
          "properties": {
            "field": { "$ref": "#/definitions/locator" },
            "value": { "type": "string", "description": "The text to type; may be {{var.name}}. Never a Site Login credential. With secret: true it must be exactly one {{var.name}} template." },
            "secret": { "type": "boolean", "description": "Only with secret: true may fill type into a password input. The value must be exactly one {{var.name}} template, is masked in everything the run shows, and the steps must be signed." }
          },
          "if": { "required": ["secret"], "properties": { "secret": { "const": true } } },
          "then": { "properties": { "value": { "type": "string", "pattern": "^\\{\\{\\s*var\\.[A-Za-z0-9_]+\\s*\\}\\}$" } } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-select": {
      "type": "object",
      "required": ["select"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "select": {
          "type": "object",
          "required": ["field", "value"],
          "properties": {
            "field": { "$ref": "#/definitions/locator" },
            "value": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 100 }
              ],
              "description": "The option to choose; may be {{var.name}}. For a multi-select, an array selects exactly those options and clears the others."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-check": {
      "type": "object",
      "required": ["check"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "check": {
          "type": "object",
          "required": ["field"],
          "properties": {
            "field": { "$ref": "#/definitions/locator" },
            "checked": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-clickAll": {
      "type": "object",
      "required": ["clickAll"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "clickAll": {
          "type": "object",
          "required": ["target", "max"],
          "properties": {
            "target": { "$ref": "#/definitions/locator" },
            "max": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-waitFor": {
      "type": "object",
      "required": ["waitFor"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "waitFor": {
          "type": "object",
          "properties": {
            "target": { "$ref": "#/definitions/locator" },
            "state": { "enum": ["visible", "hidden", "attached"] },
            "hasText": { "type": "string", "minLength": 1 },
            "minCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "response": {
              "type": "object",
              "required": ["urlContains"],
              "properties": { "urlContains": { "type": "string", "minLength": 1 } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "anyOf": [
            { "required": ["target"] },
            { "required": ["response"] }
          ]
        }
      },
      "additionalProperties": false
    },
    "verb-paginate": {
      "type": "object",
      "required": ["paginate"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "paginate": {
          "type": "object",
          "required": ["next", "until", "max", "each"],
          "properties": {
            "next": { "$ref": "#/definitions/locator" },
            "until": { "enum": ["absent", "disabled"] },
            "max": { "type": "integer", "minimum": 1, "maximum": 100 },
            "nextWaitMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "each": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": { "$ref": "#/definitions/nestedStep" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "type": "object",
        "description": "A paginate whose body holds a submit or a download writes.",
        "properties": { "paginate": { "type": "object", "properties": { "each": { "type": "array", "contains": { "type": "object", "anyOf": [{ "required": ["submit"] }, { "required": ["download"] }] } } } } }
      },
      "then": {
        "description": "Its when is a write step's when (no run variable condition), and its own when, expect and next hold no {{var.name}}: a run variable never decides whether or how often the write runs.",
        "properties": {
          "when": { "$ref": "#/definitions/writeWhen" },
          "expect": { "$ref": "#/definitions/writeExpect" },
          "paginate": { "properties": { "next": { "$ref": "#/definitions/noVarLocator" } } }
        }
      }
    },
    "verb-extract": {
      "type": "object",
      "required": ["extract"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "extract": {
          "type": "object",
          "description": "Rows from a page or a list. Needs an idPattern or an item locator.",
          "required": ["scope"],
          "properties": {
            "scope": { "$ref": "#/definitions/locator" },
            "item": { "$ref": "#/definitions/locator" },
            "fields": { "type": "object", "additionalProperties": { "$ref": "#/definitions/fieldSpec" } },
            "idPattern": { "$ref": "#/definitions/regex" },
            "textMode": { "enum": ["text", "textContent"] }
          },
          "additionalProperties": false,
          "anyOf": [
            { "required": ["idPattern"] },
            { "required": ["item"] }
          ]
        }
      },
      "additionalProperties": false
    },
    "verb-submit": {
      "type": "object",
      "required": ["submit"],
      "properties": {
        "intent": true, "optional": true, "when": { "$ref": "#/definitions/writeWhen" }, "expect": { "$ref": "#/definitions/writeExpect" }, "checkpoint": true, "timeoutMs": true,
        "submit": {
          "type": "object",
          "description": "A declared write: the only write target allowed, and only while this step runs.",
          "required": ["button", "path"],
          "properties": {
            "button": { "$ref": "#/definitions/writeLocator" },
            "path": { "type": "string", "pattern": "^/", "not": { "$ref": "#/definitions/varTemplate" } },
            "host": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } },
            "method": { "$ref": "#/definitions/method" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-download": {
      "type": "object",
      "required": ["download"],
      "properties": {
        "intent": true, "optional": true, "when": { "$ref": "#/definitions/writeWhen" }, "expect": { "$ref": "#/definitions/writeExpect" }, "checkpoint": true, "timeoutMs": true,
        "download": {
          "type": "object",
          "required": ["trigger"],
          "properties": {
            "trigger": { "$ref": "#/definitions/writeLocator" },
            "via": {
              "type": "object",
              "description": "A download through a form post (a declared write).",
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "host": { "type": "string", "minLength": 1 },
                "method": { "$ref": "#/definitions/method" }
              },
              "additionalProperties": false
            },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 209715200 },
            "mime": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/varTemplate" } } },
            "check": { "$ref": "#/definitions/fileCheck" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-popup": {
      "type": "object",
      "required": ["popup"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "popup": {
          "type": "object",
          "required": ["trigger"],
          "properties": { "trigger": { "$ref": "#/definitions/locator" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-detect": {
      "type": "object",
      "required": ["detect"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "detect": {
          "type": "object",
          "required": ["name", "checks"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "checks": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/locator" } },
            "require": { "type": "string", "minLength": 1, "description": "The name of one of the checks." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-screenshot": {
      "type": "object",
      "required": ["screenshot"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "screenshot": {
          "type": "object",
          "required": ["capture"],
          "properties": {
            "capture": { "enum": ["full", "viewport", "element"] },
            "element": { "$ref": "#/definitions/locator" }
          },
          "additionalProperties": false,
          "if": { "properties": { "capture": { "const": "element" } } },
          "then": { "required": ["element"] },
          "else": { "not": { "required": ["element"] } }
        }
      },
      "additionalProperties": false
    },
    "verb-pdf": {
      "type": "object",
      "required": ["pdf"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "pdf": {
          "type": "object",
          "properties": {
            "paper": { "enum": ["A4", "Letter"] },
            "background": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-read": {
      "type": "object",
      "required": ["read"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "read": {
          "type": "object",
          "required": ["what"],
          "properties": { "what": { "enum": ["text", "html", "title", "url"] } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-extractTable": {
      "type": "object",
      "required": ["extractTable"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "extractTable": {
          "type": "object",
          "required": ["table"],
          "properties": {
            "table": { "$ref": "#/definitions/locator" },
            "idPattern": { "$ref": "#/definitions/regex" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-press": {
      "type": "object",
      "required": ["press"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "press": {
          "type": "object",
          "description": "Presses one key chord on target, or with no target on the element that has the focus. Refused on a password field. Not a declared write: a key that would post a form is refused like a click on its button.",
          "required": ["key"],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^((Ctrl\\+)?(Alt\\+)?(Shift\\+)?(Enter|Tab|Escape|Backspace|Delete|Up|Down|Left|Right|PageUp|PageDown|Home|End|F[1-9]|F1[0-2])|Ctrl\\+A)$",
              "description": "Enter, Tab, Escape, Backspace, Delete, Up, Down, Left, Right, PageUp, PageDown, Home, End or F1 to F12, alone or after Ctrl, Alt and Shift in that order (Shift+Tab, Ctrl+Enter), or Ctrl+A. Never a key that types a character, and never {{var.name}}."
            },
            "target": { "$ref": "#/definitions/locator" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verb-hover": {
      "type": "object",
      "required": ["hover"],
      "properties": {
        "intent": true, "optional": true, "when": true, "expect": true, "checkpoint": true, "timeoutMs": true,
        "hover": { "$ref": "#/definitions/locator", "description": "Moves the mouse over one element, for a menu that opens on hover." }
      },
      "additionalProperties": false
    }
  }
}
