{
  "name": "n8n-nodes-rpa",
  "version": "0.2.0",
  "description": "Robotic process automation (RPA) for self-hosted n8n: bots that drive a browser and Windows desktop apps. Record or import them (UiPath, Chrome Recorder), approve and sign their steps, and let browser steps repair themselves with AI.",
  "license": "MIT",
  "homepage": "https://github.com/jb-n8n/n8n-nodes-rpa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jb-n8n/n8n-nodes-rpa.git",
    "directory": "packages/n8n-nodes-rpa"
  },
  "bugs": {
    "url": "https://github.com/jb-n8n/n8n-nodes-rpa/issues"
  },
  "author": {
    "name": "Jay Byoun",
    "email": "290073995+jb-n8n@users.noreply.github.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "rpa",
    "browser-automation",
    "web-scraping",
    "self-healing",
    "playwright"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "n8n-nodes-rpa": "dist/setup.mjs"
  },
  "files": [
    "dist",
    "templates",
    "THIRD-PARTY-NOTICES.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/PlaywrightBrowserApi.credentials.js",
      "dist/credentials/PlaywrightSiteLoginApi.credentials.js",
      "dist/credentials/PlaywrightScriptSigningApi.credentials.js",
      "dist/credentials/PlaywrightRedisApi.credentials.js",
      "dist/credentials/RpaDesktopRunnerApi.credentials.js",
      "dist/credentials/RpaSecretVariablesApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Playwright/Playwright.node.js"
    ]
  },
  "scripts": {
    "build": "pnpm --filter n8n-rpa-engine build && node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/build-setup.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "templates": "node scripts/build-templates.mjs",
    "test": "pnpm --filter n8n-rpa-engine build && tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/build-setup.mjs && vitest run",
    "test:unit": "vitest run --exclude \"test/**/*.integration.test.ts\" --exclude test/package.test.ts --exclude test/lazy-engine.test.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "playwright-core": "1.63.0",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "0.37.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "n8n-rpa-engine": "workspace:*",
    "n8n-rpa-sandbox": "workspace:*",
    "n8n-workflow": "2.44.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  }
}
