      "id": "3d6f1a20-7b4c-4e8a-9c11-000000000605",
      "name": "Read new mail",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        660,
        -240
      ],
      "disabled": true,
      "alwaysOutputData": true,
      "notes": "Off until you use email: pick your mail account here, then turn the node on. Lists the newest mails since the request. On Gmail, use Gmail's Get Many messages instead."
    },
    {
      "parameters": {
        "jsCode": "// One item { code }: the code from the newest mail since the request from a sender in Settings, or '' when none has\n// come yet (notFromSender: how many fitting mails came from another address).\nconst s = $('Settings').first().json;\nconst items = $input.all().map((item) => item.json);\nif (items.some((m) => m.source !== undefined && m.requestedAt !== undefined)) {\n  throw new Error('Read new mail is off. Open it, pick your mail account and turn it on, or change source in Settings.');\n}\n// sender: one address, or a few separated by commas. Compared whole, never as a part of the From text.\nconst senders = String(s.sender ?? '').split(/[\\s,;]+/).map((a) => a.trim().toLowerCase()).filter(Boolean);\nif (!senders.length) throw new Error('In Settings, set sender to the address the site sends its code mail from.');\n// One item per mail (Outlook, Gmail), or one answer that lists them under messages or value (a mail API).\nconst mails = items.flatMap((m) => (Array.isArray(m.messages) ? m.messages : Array.isArray(m.value) ? m.value : [m]));\nconst bare = (v) => (/^[^\\s@<>\"]+@[^\\s@<>\"]+$/.test(v) ? v : '');\n// The sender's address itself: Outlook from.emailAddress.address, Gmail from.value[0].address, a mail API's\n// From.Address, or a From header: the address in its last <...>, else the whole value when it is a bare address.\nconst addressOf = (m) => {\n  const f = m.from ?? m.From;\n  if (f && typeof f === 'object') {\n    const a = f.emailAddress?.address ?? (Array.isArray(f.value) && f.value.length === 1 ? f.value[0]?.address : undefined) ?? f.Address ?? f.address;\n    return typeof a === 'string' ? bare(a.trim().toLowerCase()) : '';\n  }\n  if (typeof f !== 'string') return '';\n  const angle = /<([^<>]*)>\\s*$/.exec(f);\n  return bare((angle ? angle[1] : f).trim().toLowerCase());\n};\nconst since = Date.parse(s.requestedAt) - Number(s.lookBackSeconds) * 1000;\nconst pattern = new RegExp(s.codePattern);\nconst fitting = mails\n  .map((m) => {\n    const when = m.receivedDateTime ?? m.date ?? m.internalDate ?? m.Created;\n    const at = /^\\d+$/.test(String(when)) ? Number(when) : Date.parse(when);\n    const subject = String(m.subject ?? m.Subject ?? '');\n    const body = [m.bodyPreview, m.body?.content, m.snippet, m.Snippet, m.text, m.Text]\n      .filter((v) => typeof v === 'string').join('\\n').replace(/<[^>]*>/g, ' ');\n    return { at, subject, from: addressOf(m), body };\n  })\n  .filter((m) => m.at >= since)\n  .filter((m) => !s.subjectHas || m.subject.toLowerCase().includes(String(s.subjectHas).toLowerCase()));\nconst code = fitting\n  .filter((m) => senders.includes(m.from))\n  .sort((a, b) => b.at - a.at)\n  .map((m) => { const found = `${m.subject}\\n${m.body}`.match(pattern); return found ? (found[1] ?? found[0]) : ''; })\n  .find((c) => c !== '');\nreturn [{ json: { code: code ?? '', notFromSender: fitting.filter((m) => !senders.includes(m.from)).length } }];\n"
      },
