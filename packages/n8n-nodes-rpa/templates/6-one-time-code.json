    {
      "parameters": {
        "jsCode": "// One item { code, id }: the newest code typed since the request for this account (or for any account), or code ''.\nconst s = $('Settings').first().json;\nconst since = Date.parse(s.requestedAt) - Number(s.lookBackSeconds) * 1000;\nconst account = String(s.account ?? '').trim().toLowerCase();\nconst row = $input.all().map((item) => item.json)\n  .filter((r) => r.id !== undefined && Date.parse(r.createdAt) >= since)\n  .filter((r) => !r.account || !account || String(r.account).trim().toLowerCase() === account)\n  .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt))[0];\nreturn [{ json: row ? { code: String(row.code ?? '').replace(/\\s/g, ''), id: row.id } : { code: '' } }];\n"
      },
