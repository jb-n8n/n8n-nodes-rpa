      "parameters": {
        "jsCode": "// Up to giveUpSeconds in all: waits 5 seconds, then the loop looks again. No Wait node: it would pause the bot's run.\nconst s = $('Settings').first().json;\nif (Date.now() - Date.parse(s.startedAt) > Number(s.giveUpSeconds) * 1000) {\n  throw new Error(`No code mail came from ${s.sender} in ${s.giveUpSeconds} seconds.${$input.first().json.notFromSender ? ' Mails from other addresses were left alone.' : ''} Check sender and subjectHas in Settings.`);\n}\nawait new Promise((resolve) => setTimeout(resolve, 5000));\nreturn [{ json: { tryAgain: true } }];\n"
      },
