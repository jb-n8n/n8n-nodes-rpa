{
  "name": "sandbox-line-items",
  "startUrl": "http://sandbox:8080/acme/login",
  "steps": [
    {
      "intent": "Sign in with an authentication code",
      "signIn": {
        "username": { "label": "user ID" },
        "password": { "label": "Password", "exact": true },
        "submit": { "role": "button", "name": "Sign in", "exact": true },
        "totp": { "field": { "label": "Authentication code", "exact": true }, "submit": { "role": "button", "name": "Verify", "exact": true } }
      }
    },
    { "intent": "Open http://sandbox:8080/sap/bc/gui/sap/its/webgui", "goto": "http://sandbox:8080/sap/bc/gui/sap/its/webgui" },
    { "intent": "Click Line Item Report", "click": { "role": "button", "name": "Line Item Report", "exact": true } },
    { "intent": "Choose \"1000\" in Company Code", "select": { "field": { "label": "Company Code", "exact": true }, "value": "1000" } },
    { "intent": "Type into From: \"2026-09-01\"", "fill": { "field": { "label": "From", "exact": true }, "value": "2026-09-01" } },
    { "intent": "Type into To: \"2026-09-30\"", "fill": { "field": { "label": "To", "exact": true }, "value": "2026-09-30" } },
    { "intent": "Click Execute", "click": { "role": "button", "name": "Execute", "exact": true } },
    {
      "intent": "Download with Export",
      "download": {
        "trigger": { "role": "button", "name": "Export", "exact": true },
        "mime": ["text/csv"],
        "check": { "name": "^LINEITEMS_1000_", "columns": ["Document", "Posting Date", "Company Code", "Amount", "Currency"], "minRows": 1 }
      }
    }
  ]
}
