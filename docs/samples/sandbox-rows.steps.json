{
  "name": "sandbox-rows",
  "startUrl": "http://sandbox:8080/acme/login",
  "steps": [
    {
      "intent": "Sign in, with the authenticator code when the site asks for one",
      "signIn": {
        "username": { "label": "user ID" },
        "password": { "label": "Password", "exact": true },
        "submit": { "role": "button", "name": "Sign in", "exact": true },
        "totp": { "field": { "label": "Authentication code", "exact": true }, "submit": { "role": "button", "name": "Verify", "exact": true } }
      }
    },
    { "intent": "Open Service", "click": { "role": "link", "name": "Service", "exact": true, "within": { "role": "navigation" } } },
    { "intent": "Open Recalls & Stop-Sales", "click": { "role": "link", "name": "Recalls & Stop-Sales" }, "expect": { "heading": "Recalls & Stop-Sales" } },
    {
      "intent": "Read every page of notices",
      "paginate": {
        "next": { "text": "Next page" },
        "until": "absent",
        "max": 10,
        "each": [
          { "intent": "Read the notices on this page", "extract": { "scope": { "css": "main" }, "idPattern": "N26-\\d{4}", "textMode": "textContent" } }
        ]
      }
    }
  ]
}
