<Project Sdk="Microsoft.NET.Sdk">
  <!-- The runner executable: wires the core to the Windows driver. Publish: dotnet publish -c Release -r win-x64. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>RpaRunner</AssemblyName>
    <RootNamespace>Rpa.Runner</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rpa.Runner.Core\Rpa.Runner.Core.csproj" />
    <ProjectReference Include="..\Rpa.Runner.Windows\Rpa.Runner.Windows.csproj" />
  </ItemGroup>
</Project>
