# Copy this file to .env and fill in the values. .env is git-ignored.

# Token for the gate in front of the browser server (at least 32 characters). Generate it with:
# openssl rand -hex 32
BROWSER_TOKEN=

# Key n8n encrypts credentials with. Generate it with:
#   openssl rand -hex 32
# A stack started before this variable existed already has a key in its n8n_data volume: set this to that key
# (README: Hello world in 10 minutes) or start fresh with `docker compose down -v` (deletes the volumes: workflows,
# credentials, executions). Changing it later makes every saved credential unreadable.
N8N_ENCRYPTION_KEY=

