# Copy this file to .env and fill in the values. .env is git-ignored.

# Token for the gate in front of the browser server (at least 32 characters). Generate it with:
# openssl rand -hex 32
BROWSER_TOKEN=

# Key n8n encrypts credentials with. Generate it with:
#   openssl rand -hex 32
# A stack started before this variable existed already has a key in its n8n_data volume: set this to that key
# (docs/guides/browser-bot.md, step 1) or start fresh with `docker compose down -v` (deletes the volumes: workflows,
# credentials, executions). Changing it later makes every saved credential unreadable.
N8N_ENCRYPTION_KEY=


# Optional. The port n8n is published on (default 5678), on 127.0.0.1. The same setting is the port in n8n's address
# for forms and approval links (N8N_WEBHOOK_URL), so the two cannot point at different n8n instances. The queue-mode
# stack (docker-compose.queue.yml) reads RPA_QUEUE_N8N_PORT instead (default 35678).
# RPA_N8N_PORT=5678
